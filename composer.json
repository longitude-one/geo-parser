{
    "name": "longitude-one/geo-parser",
    "type": "library",
    "description": "Parser for geography coordinate strings",
    "keywords": ["parser", "lexer", "string", "text", "geometry", "geography", "spatial", "geo", "coordinate"],
    "authors": [
        {
            "name":  "Alexandre Tranchant",
            "email": "alexandre.tranchant@gmail.com"
        },
        {
            "name":  "Derek J. Lambert",
            "email": "dlambert@dereklambert.com"
        }
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "doctrine/lexer": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.33"
    },
    "scripts": {
        "quality": [
            "quality/php-cs-fixer/vendor/bin/php-cs-fixer fix --config=quality/php-cs-fixer/.php-cs-fixer.php --allow-risky=yes --dry-run",
            "quality/php-stan/vendor/bin/phpstan analyse --configuration=quality/php-stan/php-stan.neon lib tests --error-format=table --no-progress --no-interaction --no-ansi --level=9 --memory-limit=256M",
            "quality/php-mess-detector/vendor/bin/phpmd lib text quality/php-mess-detector/ruleset.xml",
            "quality/php-mess-detector/vendor/bin/phpmd tests text quality/php-mess-detector/test-ruleset.xml"
        ],
        "test": "phpunit",
        "test-local": [
            "phpunit",
            "sed -i.bak 's|/var/www/|./|g' .phpunit.cache/coverage.xml",
            "rm .phpunit.cache/coverage.xml.bak",
            "cat .phpunit.cache/coverage-results.txt"
        ]
    },
    "autoload": {
        "psr-0": {
            "LongitudeOne\\Geo\\String": "lib/"
        }
    },
    "autoload-dev": {
        "psr-0": {
            "LongitudeOne\\Geo\\String\\Tests": "tests/"
        }
    }
}
